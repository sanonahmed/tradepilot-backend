# TradePilot AI Environment Variables

# Service Mode
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=TradePilot AI

# Security (Change in production!)
SECRET_KEY=tradepilot-secret-key-production-needs-to-generate-a-strong-random-key-64chars
ENCRYPTION_KEY=tradepilot-aes256-gcm-secret-key-32bytes-exactly!!
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Neon PostgreSQL in production; SQLite fallback supported in dev)
# Example Neon: postgresql+asyncpg://user:pass@ep-cool-db.us-east-2.aws.neon.tech/tradepilot?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./tradepilot.db

# Redis Coordination (Optional for dev, required for distributed worker coordination)
REDIS_URL=redis://localhost:6379/0

# Binance API (Optional global or per-user configured)
BINANCE_USE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=

# External Services
GEMINI_API_KEY=
FCM_SERVER_KEY=
